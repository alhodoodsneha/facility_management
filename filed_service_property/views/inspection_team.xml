<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_inspection_team" model="ir.ui.view">
        <field name="name">inspection.team.member.form.view</field>
        <field name="model">inspection.team.member</field>
        <field name="arch" type="xml">
            <form string="Inspection Team">
                <header>
                </header>
                <sheet>
                    <label for="name"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="team_manager_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_inspection_team" model="ir.ui.view">
        <field name="name">inspection.team.member.tree.view</field>
        <field name="model">inspection.team.member</field>
        <field name="arch" type="xml">
            <list string="Inspection Team" create="1" delete="1">
                <field name="name"/>
                <field name="team_manager_id"/>
                <field name="team_member_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>


    <!-- Action to open the list view of inspection team model -->
    <record id="action_inspection_team" model="ir.actions.act_window">
        <field name="name">Inspection Team</field>
        <field name="res_model">inspection.team.member</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tree_inspection_team"/>
        <field name="help" type="html">
            <p>
                Create and manage your Inspection team
            </p>
        </field>
    </record>

    <menuitem
            name="Inspection Team"
            id="menu_inspection_team"
            parent="project.menu_project_config"
            action="action_inspection_team"
            sequence="11"
    />

</odoo>