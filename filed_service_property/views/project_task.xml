<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_task_form_property_fsm" model="ir.ui.view">
        <field name="name">view.task.form.property.fsm.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="_is_inspection_task" invisible="1"/>
                <field name="is_completed" invisible="1"/>
                 <field name="crm_lead_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                       readonly="1"/>
            </xpath>
             <xpath expr="//field[@name='milestone_id']" position="before">
                <field name="sequence_code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <label for="street1_f" string="Address" invisible="_is_inspection_task == False"></label>
                <div class="o_address_format" invisible="_is_inspection_task == False">
                    <field name="street1_f" no_label="1" placeholder="Street..." class="o_address_street"/>
                    <field name="street2_f" no_label="1" class="o_address_street" placeholder="Street 2..."/>
                    <field name="city_f" placeholder="City" class="o_address_city"/>
                    <field name="state__f_id" placeholder="State" class="o_address_state"
                           options="{'no_open': True, 'no_quick_create': True}"/>
                    <field name="zip_f" placeholder="ZIP" class="o_address_zip" invisible="1"/>
                    <div name="property_address_country" class="d-flex justify-content-between">
                        <field name="country_f_id" placeholder="Country" class="o_address_country"
                               options='{"no_open": True, "no_create": True}'/>
                    </div>
                </div>
                <field name="property_status" invisible="_is_inspection_task == False and is_fsm == False"/>
                <field name="property_project" invisible="_is_inspection_task == False and is_fsm == False"/>
                <field name="property_id" invisible="_is_inspection_task == False and is_fsm == False"/>
                <field name="property_unit" invisible="_is_inspection_task == False and is_fsm == False"/>
                <field name="property_request" invisible="_is_inspection_task == False and is_fsm == False"/>
            </xpath>
            <xpath expr="//field[@name='active']" position="before">
                <field name="fsm_sale_order_id" invisible="is_fsm == False" readonly="1"/>
                <field name="quoted_amount" invisible="is_fsm == False" readonly="1"/>
                <field name="job_type" invisible="is_fsm == False" readonly="1"/>
                <field name="partner_phone" invisible="_is_inspection_task == False"/>
                <field name="preferable_time" invisible="_is_inspection_task == False"/>
                <field name="preferable_end_time"  invisible="_is_inspection_task == False"/>
                <field name="location_url" widget="url" placeholder="e.g. https://www.odoo.com" invisible="_is_inspection_task == False"/>
                <field name="estimation_total" invisible="_is_inspection_task == False"/>
            </xpath>
             <xpath expr="//page[@name='description_page']" position="after">
                 <page name="inspection_lines" string="Inspection" invisible="_is_inspection_task == False">
                   <field name="inspection_attachment_ids" widget="one2many"
                           readonly="is_completed == True">
                        <list string="Inspection" editable="bottom" delete="1" create="1">
                            <field name="task_id" column_invisible="1"/>
                              <field name="is_completed" column_invisible="1"/>
                             <field name="description"
                                   readonly="is_completed == True"/>
                            <field name="images" widget="image"
                                   readonly="is_completed == True"/>
                        </list>
                    </field>
                </page>
                  <page name="estimation_lines" string="Estimation" invisible="_is_inspection_task == False">
                    <field name="estimation_line_ids" widget="one2many"  readonly="is_completed == True">
                        <list string="Estimation" editable="bottom" delete="1" create="1">
                            <field name="task_id" column_invisible="1"/>
                            <field name="description" required="1"/>
                            <field name="qty"/>
                            <field name="unit_price" />
                            <field name="line_margin" readonly="1"/>
                            <field name="total" sum="Estimation Total"/>
                        </list>
                    </field>
                    <separator string="Margin%"/>
                    <field name="margin"/>
                    <button class="oe_highlight"
                            name="action_margin_update" type="object"
                            invisible="is_completed == True"
                            string="Margin Update"
                            data-hotkey="i"/>
                </page>
                  <page name="consumable_lines" string="Consumable Material" invisible="is_fsm == False">
                    <field name="consumable_line_ids" widget="one2many" >
                        <list string="Consumable Material" editable="bottom" delete="1" create="1">
                            <field name="task_id" column_invisible="1"/>
                            <field name="project_id" column_invisible="1"/>
                            <field name="product_id" required="1"/>
                            <field name="quantity"/>
                            <field name="uom_id" />
                        </list>
                    </field>
                </page>
             </xpath>
            <xpath expr="//field[@name='stage_id']" position="before">
                 <button name="action_completed_inspection" string="Completed"
                        type="object" class="oe_highlight" data-hotkey="o"
                        invisible="_is_inspection_task == False or is_completed == True"/>
                  <button name="%(action_report_inspection_task)d"
                    string="Inspection Report"
                    type="action"
                    class="btn-primary"
                    invisible="_is_inspection_task == False"
                    />

            </xpath>
        </field>
     </record>

     <record id="view_task_form2_inherit_fsm_inherited" model="ir.ui.view">
        <field name="name">view.task.form2.fsm.inherit.property.inherited</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm_sale.view_task_form2_inherit"/>
        <field name="arch" type="xml">
              <xpath expr="//button[@name='action_fsm_view_material']" position="attributes">
                  <attribute name="invisible">job_type in ['one_time','amc_work']</attribute>
              </xpath>
              <xpath expr="//button[@name='action_fsm_validate']" position="after">
                   <button name="action_create_new_quotation" string="New Quotation"
                        type="object" class="oe_highlight" data-hotkey="o"
                        invisible="is_fsm == False or job_type not in ['amc_work']"/>
              </xpath>
               <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                     <button name="action_view_other_quotation" type="object"
                        string="Quotations"
                        invisible="is_fsm == False or job_type not in ['amc_work']"
                        class="oe_stat_button"
                        icon="fa-file-text">
                </button>
                    <button name="action_view_picking" type="object"
                        string="Stock Move"
                        invisible="is_fsm == False or job_type not in ['amc_work']"
                        class="oe_stat_button"
                        icon="fa-exchange">
                </button>
               </xpath>
        </field>
     </record>


      <record id="action_inspection_task" model="ir.actions.act_window">
        <field name="name">Inspection Task</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="domain">[('_is_inspection_task', '=', True)]</field>
        <field name="context">{'default__is_inspection_task':
            True,'search_default_open_tasks':
            1,'create': False,'delete': False,}
        </field>
        <field name="help" type="html">
            <p>View Inspection Task</p>
        </field>
    </record>

      <menuitem
            name="Inspection Task"
            id="menu_inspection_task"
            action="action_inspection_task"
            parent="project.menu_main_pm"
            groups="filed_service_property.group_inspection_user,filed_service_property.group_inspection_manager"
            sequence="8"
    />
    <menuitem
            name="Inspection Task"
            id="menu_inspection_task_fsm"
            action="action_inspection_task"
            parent="industry_fsm.fsm_menu_root"
            groups="industry_fsm.group_fsm_manager,industry_fsm.group_fsm_user"
            sequence="15"
    />




</odoo>
