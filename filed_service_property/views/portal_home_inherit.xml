<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_change_requests" name="Enquiry" inherit_id="portal.portal_my_home" customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/filed_service_property/static/src/img/bill.svg'"/>
                    <t t-set="title">Enquiry</t>
                    <t t-set="url" t-value="'/my/change-requests'"/>
                    <t t-set="text">View your Enquiry requests</t>
                    <t t-set="placeholder_count" t-value="'change_request_count'"/>
                </t>
        </xpath>
    </template>

</odoo>
