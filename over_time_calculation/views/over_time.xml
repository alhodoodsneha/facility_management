<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_employee_overtime" model="ir.ui.view">
        <field name="name">employee.overtime.form.view</field>
        <field name="model">employee.overtime</field>
        <field name="arch" type="xml">
            <form string="Over Time">
                <header>
                    <button name="action_generate"
                    type="object"
                    string="Generate"
                    class="btn-primary"/>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <label for="name"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                     <notebook>
                        <page string="Over Time"
                              name="over_time_page">
                            <field name="line_ids" widget="one2many">
                                <list string="Over Time" editable="bottom">
                                    <field name="overtime_id" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="date_start"/>
                                    <field name="worked_hours"/>
                                    <field name="overtime_hours"/>
                                </list>
                            </field>
                        </page>
                     </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_employee_overtime" model="ir.ui.view">
        <field name="name">employee.overtime.tree.view</field>
        <field name="model">employee.overtime</field>
        <field name="arch" type="xml">
            <list string="Over Time" create="1" delete="1">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- Action to open the list view of inspection team model -->
    <record id="action_employee_overtime" model="ir.actions.act_window">
        <field name="name">Over Time</field>
        <field name="res_model">employee.overtime</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tree_employee_overtime"/>
        <field name="help" type="html">
            <p>
                Create and manage your Over Time
            </p>
        </field>
    </record>

    <menuitem
            name="Over Time"
            id="menu_employee_overtime"
            parent="hr_timesheet.timesheet_menu_root"
            action="action_employee_overtime"
            sequence="20"
    />
</odoo>